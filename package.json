{
  "name": "quarto-table-support",
  "displayName": "Quarto Table Support",
  "description": "Visual editor for the Quarto unified table syntax (::: {.tbl}) used by design-doc-quarto-template",
  "version": "0.1.0",
  "publisher": "ramsesyok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramsesyok/quarto-table-support"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "quartoTable.open",
        "title": "Open Table Editor",
        "category": "Quarto Table"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "quartoTable.open",
          "when": "editorTextFocus && (resourceExtname == .qmd || resourceExtname == .md)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
